# DeepSeek API 配置 —— 复制本文件为 .env.local 并填入真实 key
# key 获取：https://platform.deepseek.com → API keys
DEEPSEEK_API_KEY=
# 以下两项有默认值，一般无需修改
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ===== Supabase（可选：不配置则保持本地模式，功能不受影响）=====
# 项目首页 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 简易邮箱验证（注册时创建已确认账号）需要 Service Role Key；仅在服务端读取，绝不公开
SUPABASE_SERVICE_ROLE_KEY=

# ===== 公网部署防护（可选）：两值一致时自动启用接口 Token 校验 + 限流 =====
# DEMO_TOKEN=换成随机长串
# NEXT_PUBLIC_DEMO_TOKEN=与 DEMO_TOKEN 相同
